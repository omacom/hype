# Package this fork as hype-html, beside an installed hype: the same app with
# the HTML deck export, under its own name, icon, and desktop entry. The
# source is the checkout this PKGBUILD lives in, at the branch checked out
# there, so commit before building and re-run makepkg after pulling.
pkgname=hype-html
pkgver=0.7.1
pkgrel=1
pkgdesc='Simple Markdown presentations with a visual slide editor and self-contained HTML deck export'
arch=('x86_64')
url='https://github.com/razodin137/hype'
license=('MIT')
options=('!debug')
depends=(
  'ffmpeg'
  'hicolor-icon-theme'
  'qt6-base>=6.9'
  'qt6-declarative>=6.9'
  'qt6-multimedia>=6.9'
  'qt6-imageformats'
  'qt6-svg'
  'source-highlight'
  'zlib'
  'libwebp'
  'xdg-desktop-portal'
  'qt6-wayland'
)
makedepends=('cmake' 'gcc' 'make' 'pkgconf' 'git' 'qt6-shadertools')

# This PKGBUILD sits at <checkout>/pkgbuild/hype-html, so the checkout root is
# two levels up. Cloning from there lets any checkout build itself; git source
# means the package still tracks the committed branch, not the working tree.
_checkout="$(realpath -- "$(dirname -- "${BASH_SOURCE[0]}")/../..")"
source=("$pkgname::git+file://${_checkout}")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname"

  install -Dm755 build/hype "$pkgdir/usr/bin/hype-html"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/hype.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/hype-html.svg"
  install -Dm644 pkgbuild/hype-html.desktop "$pkgdir/usr/share/applications/hype-html.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
